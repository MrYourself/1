{
  "name": "twitch-chat-overlay",
  "version": "0.2.1-beta.5",
  "description": "Transparentes Twitch- und TikTok-Livechat-Overlay für Windows",
  "main": "src/main.js",
  "author": "Jonas",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer/app.js && node --check src/captions-preload.js && node --check src/captions/captions.js && node --check src/captions/audio-worklet.js && node --check src/captions/display.js && node --check src/captions/web/overlay.js && node --test tests/*.test.js",
    "dist:win": "electron-builder --win portable nsis --x64",
    "release:win": "electron-builder --win nsis portable --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "tiktok-live-connector": "^2.4.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "44.1.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "de.jonas.twitchchatoverlay",
    "productName": "Twitch Chat Overlay",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Twitch-Chat-Overlay-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MrYourself",
        "repo": "1",
        "releaseType": "draft"
      }
    ],
    "portable": {
      "artifactName": "Twitch-Chat-Overlay-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@44.1.0": true
  }
}
